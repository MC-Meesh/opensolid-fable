ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('OpenSolid B-Rep export'),'2;1');
FILE_NAME('OpenSolid part','',(''),(''),'OpenSolid','OpenSolid','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1 = APPLICATION_CONTEXT('configuration controlled 3d designs of mechanical parts and assemblies');
#2 = APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#3 = MECHANICAL_CONTEXT('',#1,'mechanical');
#4 = DESIGN_CONTEXT('',#1,'design');
#5 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#6 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#7 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#8 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.0E-7),#5,'distance_accuracy_value','confusion accuracy');
#9 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#8)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#5,#6,#7)) REPRESENTATION_CONTEXT('Context #1','3D Context') );
#10 = PRODUCT('OpenSolid part','OpenSolid part','',(#3));
#11 = PRODUCT_RELATED_PRODUCT_CATEGORY('part','',(#10));
#12 = PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('','',#10,.NOT_KNOWN.);
#13 = PRODUCT_DEFINITION('design','',#12,#4);
#14 = PRODUCT_DEFINITION_SHAPE('','',#13);
#15 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#16 = DIRECTION('',(0.0,0.0,1.0));
#17 = DIRECTION('',(1.0,0.0,0.0));
#18 = AXIS2_PLACEMENT_3D('',#15,#16,#17);
#19 = SPHERICAL_SURFACE('',#18,3.0);
#20 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#21 = DIRECTION('',(-0.0,-1.0,-0.0));
#22 = DIRECTION('',(1.0,0.0,0.0));
#23 = AXIS2_PLACEMENT_3D('',#20,#21,#22);
#24 = CIRCLE('',#23,3.0);
#25 = CARTESIAN_POINT('',(0.0,0.0,-3.0));
#26 = VERTEX_POINT('',#25);
#27 = CARTESIAN_POINT('',(0.0,0.0,3.0));
#28 = VERTEX_POINT('',#27);
#29 = EDGE_CURVE('',#26,#28,#24,.T.);
#30 = ORIENTED_EDGE('',*,*,#29,.T.);
#31 = ORIENTED_EDGE('',*,*,#29,.F.);
#32 = EDGE_LOOP('',(#30,#31));
#33 = FACE_OUTER_BOUND('',#32,.T.);
#34 = ADVANCED_FACE('',(#33),#19,.T.);
#35 = CLOSED_SHELL('',(#34));
#36 = MANIFOLD_SOLID_BREP('OpenSolid part',#35);
#37 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#38 = DIRECTION('',(0.0,0.0,1.0));
#39 = DIRECTION('',(1.0,0.0,0.0));
#40 = AXIS2_PLACEMENT_3D('',#37,#38,#39);
#41 = ADVANCED_BREP_SHAPE_REPRESENTATION('',(#40,#36),#9);
#42 = SHAPE_DEFINITION_REPRESENTATION(#14,#41);
ENDSEC;
END-ISO-10303-21;
